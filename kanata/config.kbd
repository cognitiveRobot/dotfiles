;; Caps to escape/control configuration for Kanata

(defsrc
  caps
  tab
  grv ;; nav_layer
  h j k l ;; for nav layer
)

(defcfg
    process-unmapped-keys yes
    log-layer-changes no
    concurrent-tap-hold yes
)


;; Variables
(defvar
 taptime 200
 holdtime 200
)

(defalias
  escctrl (tap-hold-release $taptime $holdtime esc lctl)
  tabhold (tap-hold-release $taptime $holdtime tab (multi lctl lalt lsft ))
  nav_layer (tap-hold $taptime $holdtime grv (layer-toggle nav)) 
  ;;apps_layer (tap-hold $taptime $holdtime lalt (layer-toggle apps)) 
  ;;sffirefox (cmd bash -c "wmctrl -a firefox || firefox")
)

(deflayer base
  @escctrl
  @tabhold
  @nav_layer
  h j k l
)

(deflayer nav
 _ _ _ left down up right
) 
