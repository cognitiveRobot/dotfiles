{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "one-dark",
  "keybinds": {
    "input_submit": "ctrl+enter",
    "messages_page_up": "pageup,ctrl+u",
    "messages_page_down": "pagedown,ctrl+d"
  },
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto"
}
